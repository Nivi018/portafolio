# ====================================
# Base de datos - Supabase PostgreSQL
# ====================================
# 1. Crea un proyecto en https://app.supabase.com
# 2. Ve a Settings > Database > Connection string
# 3. Copia la URI (connection pooling) y reemplaza los valores
#
# Ejemplo real:
# postgresql://postgres.abcdefg:miPassword123@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Connection pooling (usado por la app en runtime) - Puerto 6543
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Direct connection (usado para migraciones) - Puerto 5432
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ⚠️ IMPORTANTE: Reemplaza los placeholders antes de continuar
# Ver: prisma/SUPABASE_SETUP.md para instrucciones detalladas

# ====================================
# Auth.js
# ====================================
# Genera un secret con: openssl rand -base64 32
NEXTAUTH_SECRET="tu-secret-key-aqui-cambiar-en-produccion"
NEXTAUTH_URL="http://localhost:3000"

# ====================================
# Resend (Emails transaccionales)
# ====================================
# Obtén tu API key en: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="noreply@tu-dominio.com"

# ====================================
# Stripe (Pagos)
# ====================================
# Obtén tus keys en: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"

# ====================================
# App
# ====================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="BookingSystem"
