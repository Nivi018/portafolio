# ============================================
# DATABASE (Requerida)
# ============================================
# PostgreSQL connection string
# Para local: postgresql://usuario:password@localhost:5432/freelancer_crm
# Para Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# Para Neon: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freelancer_crm"

# ============================================
# NEXTAUTH (Requerida)
# ============================================
# URL de tu aplicación
NEXTAUTH_URL="http://localhost:3000"

# Secret para firmar JWTs (genera uno nuevo con: openssl rand -base64 32)
# IMPORTANTE: Cambia esto en producción
NEXTAUTH_SECRET=""

# ============================================
# APP URL (Requerida)
# ============================================
# URL pública usada en emails y links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# GOOGLE OAUTH (Opcional)
# ============================================
# Para habilitar login con Google
# Obtén estas credenciales en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============================================
# RESEND - EMAIL SERVICE (Opcional pero recomendado)
# ============================================
# Para envío de emails (facturas, propuestas, invitaciones, reset password)
# Obtén tu API key en: https://resend.com/api-keys
RESEND_API_KEY=""

# Email desde el cual se envían los correos
# En Resend, primero debes verificar tu dominio
RESEND_FROM_EMAIL="noreply@yourdomain.com"
