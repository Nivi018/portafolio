{
  "name": "@finance/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "cross-env RUN_DB_INTEGRATION=true vitest run src/integration.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@finance/domain": "workspace:*",
    "@finance/infrastructure": "workspace:*",
    "@finance/shared": "workspace:*",
    "@hono/node-server": "^2.0.12",
    "@hono/zod-validator": "^0.7.0",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@finance/typescript-config": "workspace:*",
    "@types/node": "^20.0.0",
    "cross-env": "^10.1.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
