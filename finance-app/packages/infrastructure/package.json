{
  "name": "@finance/infrastructure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./database": "./src/database/index.ts",
    "./auth": "./src/auth/index.ts",
    "./email": "./src/email/index.ts"
  },
  "scripts": {
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/database/seed.ts"
  },
  "dependencies": {
    "@finance/domain": "workspace:*",
    "@finance/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.8.0",
    "better-auth": "^1.4.1",
    "pg": "^8.22.0",
    "resend": "^6.16.0"
  },
  "devDependencies": {
    "@finance/typescript-config": "workspace:*",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
