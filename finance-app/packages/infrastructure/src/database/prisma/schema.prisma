generator client {
  provider = "prisma-client"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// BETTER AUTH TABLES
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Auth relations
  sessions Session[]
  accounts Account[]

  financialSpaceMemberships FinancialSpaceMember[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ============================================
// DOMAIN TABLES
// Enum values are stored as String and validated
// at the domain layer (shared constants = source of truth)
// ============================================

model FinancialSpace {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("PERSONAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members               FinancialSpaceMember[]
  categories            Category[]
  financeAccounts       FinanceAccount[]
  transactions          Transaction[]
  budgets               Budget[]
  goals                 Goal[]
  loans                 Loan[]
  assets                Asset[]
  planItems             PlanItem[]
  recurringTransactions RecurringTransaction[]

  @@map("financial_space")
}

model FinancialSpaceMember {
  id               String   @id @default(cuid())
  financialSpaceId String
  userId           String
  role             String   @default("MEMBER")
  createdAt        DateTime @default(now())

  financialSpace FinancialSpace @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([financialSpaceId, userId])
  @@index([userId])
  @@map("financial_space_member")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("wallet")
  color     String   @default("#38bdf8")
  type      String // INCOME | EXPENSE
  financialSpaceId String
  createdAt DateTime @default(now())

  financialSpace FinancialSpace @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  planItems    PlanItem[]
  recurring    RecurringTransaction[]

  @@unique([name, financialSpaceId])
  @@index([financialSpaceId])
  @@map("category")
}

model FinanceAccount {
  id        String   @id @default(cuid())
  name      String
  type      String // CHECKING | SAVINGS | CASH | CREDIT
  balance   Float    @default(0)
  currency  String   @default("MXN")
  financialSpaceId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financialSpace FinancialSpace @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)
  creditCardProfile CreditCardProfile?
  transactions Transaction[]
  planItems    PlanItem[]
  recurring    RecurringTransaction[]

  @@index([financialSpaceId])
  @@map("finance_account")
}

model CreditCardProfile {
  id                String   @id @default(cuid())
  accountId         String   @unique
  bank              String
  product           String
  creditLimit       Float
  apr               Float
  statementCloseDay Int
  paymentDueDay     Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  account FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("credit_card_profile")
}

model Transaction {
  id          String   @id @default(cuid())
  amount      Float
  description String?
  type        String // INCOME | EXPENSE | TRANSFER
  date        DateTime @default(now())
  categoryId  String?
  accountId   String
  financialSpaceId String
  recurringId String?
  createdAt   DateTime @default(now())

  financialSpace FinancialSpace  @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)
  category  Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account   FinanceAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recurring RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  loanPayment LoanPayment?

  @@index([financialSpaceId, date])
  @@index([financialSpaceId])
  @@index([accountId])
  @@index([categoryId])
  @@map("transaction")
}

model Loan {
  id                String   @id @default(cuid())
  financialSpaceId  String
  lender            String
  name              String
  originalPrincipal Float
  currentBalance    Float
  annualRate        Float
  termMonths        Int
  monthlyPayment    Float
  startDate         DateTime
  nextPaymentDate   DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  financialSpace FinancialSpace @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)
  payments       LoanPayment[]

  @@index([financialSpaceId])
  @@map("loan")
}

model LoanPayment {
  id            String   @id @default(cuid())
  loanId        String
  amount        Float
  date          DateTime
  transactionId String   @unique
  createdAt     DateTime @default(now())

  loan        Loan        @relation(fields: [loanId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([loanId])
  @@map("loan_payment")
}

model Asset {
  id               String   @id @default(cuid())
  financialSpaceId String
  name             String
  type             String
  currentValue     Float
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  financialSpace FinancialSpace   @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)
  valuations     AssetValuation[]

  @@index([financialSpaceId])
  @@map("asset")
}

model AssetValuation {
  id        String   @id @default(cuid())
  assetId   String
  value     Float
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, date])
  @@map("asset_valuation")
}

model Budget {
  id         String   @id @default(cuid())
  amount     Float
  period     String // WEEKLY | MONTHLY | YEARLY
  startDate  DateTime @default(now())
  financialSpaceId String
  categoryId String?
  createdAt  DateTime @default(now())

  financialSpace FinancialSpace @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([financialSpaceId])
  @@map("budget")
}

model Goal {
  id            String    @id @default(cuid())
  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  deadline      DateTime?
  expectedAnnualReturn Float @default(0)
  monthlyContributionTarget Float?
  financialSpaceId String
  createdAt     DateTime  @default(now())

  financialSpace FinancialSpace @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)

  @@index([financialSpaceId])
  @@map("goal")
}

model PlanItem {
  id             String   @id @default(cuid())
  financialSpaceId String
  name           String
  amount         Float
  type           String
  frequency      String
  categoryId     String?
  accountId      String?
  isFixed        Boolean  @default(false)
  isMicroExpense Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  financialSpace FinancialSpace @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)
  category       Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account        FinanceAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([financialSpaceId])
  @@index([categoryId])
  @@index([accountId])
  @@map("plan_item")
}

model RecurringTransaction {
  id          String   @id @default(cuid())
  amount      Float
  description String?
  type        String // INCOME | EXPENSE
  frequency   String // DAILY | WEEKLY | MONTHLY | YEARLY
  nextDueDate DateTime
  active      Boolean  @default(true)
  categoryId  String
  accountId   String
  financialSpaceId String
  createdAt   DateTime @default(now())

  financialSpace FinancialSpace @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)
  category     Category        @relation(fields: [categoryId], references: [id])
  account      FinanceAccount  @relation(fields: [accountId], references: [id])
  transactions Transaction[]

  @@index([financialSpaceId])
  @@index([active, nextDueDate])
  @@map("recurring_transaction")
}
