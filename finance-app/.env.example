# ============================================
# Database
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_app?schema=public"

# ============================================
# Auth (Better Auth)
# ============================================
BETTER_AUTH_SECRET="your-super-secret-key-min-32-chars-generate-one"
BETTER_AUTH_URL="http://localhost:3000"
# Optional Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============================================
# API Server
# ============================================
PORT=3001
NODE_ENV=development
# Required to invoke POST /api/recurring/process-due from a scheduler.
CRON_SECRET="replace-with-a-long-random-secret"

# ============================================
# Web (Next.js)
# ============================================
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# Email (optional - Resend)
# ============================================
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@financeapp.dev"
